# Copy to .env and fill in before the first `docker compose up`.
#
# Nothing here has a working default on purpose. A monitoring platform holds
# credentials for every device on the network, so a shipped default password is
# a shipped default password on all of them.

# --- Database --------------------------------------------------------------

NMS_DB_NAME=nms
NMS_DB_USER=nms
# Generate: openssl rand -base64 24
NMS_DB_PASSWORD=

# --- Server ----------------------------------------------------------------

# Signs session tokens. At least 32 characters.
# Generate: openssl rand -base64 48
#
# Without it the server generates one at startup, so sessions do not survive a
# restart and two replicas behind a load balancer reject each other's tokens.
NMS_JWT_SECRET=

# The first administrator's password, applied only on an empty database.
# Leave blank and one is generated and printed once to the server log.
NMS_ADMIN_PASSWORD=

# Used to build the links inside notification emails, so it has to be the
# address an operator can actually reach -- not localhost.
NMS_BASE_URL=http://localhost:3000

NMS_SERVER_PORT=8080
NMS_WEB_PORT=3000

# Worker threads executing checks. Checks are I/O-bound, so this is well above
# the core count by design. Raise it if the poller queue is persistently full.
NMS_POLLER_THREADS=50

NMS_LOG_LEVEL=INFO

# --- On-premise proxy (docker compose --profile proxy up -d) ----------------

# Shown once when the proxy is created in the interface.
NMS_PROXY_TOKEN=
NMS_PROXY_NAME=proxy-01
# The address the proxy dials out to. Public, if the server is hosted.
NMS_PROXY_SERVER_URL=http://server:8080

# --- Base images -----------------------------------------------------------
#
# Leave these alone unless the machine cannot reach Docker Hub, which is common
# on a corporate network. Retag the upstream images into your own registry and
# name them here: setting them in .env rather than editing docker-compose.yml
# keeps `git pull` free of conflicts on every upgrade.
#
# NMS_DB_IMAGE=registry.internal/timescale/timescaledb:latest-pg16
# NMS_MAVEN_IMAGE=registry.internal/maven:3.9-eclipse-temurin-21
# NMS_JRE_IMAGE=registry.internal/eclipse-temurin:21-jre-jammy
# NMS_NODE_IMAGE=registry.internal/node:22-alpine
# NMS_NGINX_IMAGE=registry.internal/nginx:1.27-alpine
